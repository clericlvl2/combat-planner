{
	"hooks": {
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "cd \"$CLAUDE_PROJECT_DIR\" && { git status --porcelain -- src | grep -q . || exit 0; } && npm run lint && npm run check",
						"timeout": 60
					}
				]
			}
		]
	},
	"worktree": {
		"baseRef": "head"
	},
	"extraKnownMarketplaces": {
		"svelte": {
			"source": {
				"source": "github",
				"repo": "sveltejs/ai-tools"
			}
		}
	},
	"enabledPlugins": {
		"svelte@svelte": true
	}
}
